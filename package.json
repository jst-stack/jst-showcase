{
	"name": "jst-showcase",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"scripts": {
		"styles:build": "tailwindcss -i ./src/tailwind.css -o ./src/index.css --minify",
		"predev": "npm run styles:build",
		"dev": "react-router dev",
		"typecheck": "react-router typegen && tsc -b --pretty false",
		"prebuild": "npm run styles:build",
		"build": "npm run typecheck && react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"lint": "eslint . --cache --cache-strategy content --max-warnings 0 && npm run lint:styles && npm run lint:architecture",
		"lint:architecture": "jst-lint architecture",
		"lint:budgets": "jst-lint budgets",
		"lint:fix": "eslint . --cache --cache-strategy content --fix && npm run lint:styles:fix",
		"lint:styles": "jst-lint styles && stylelint \"src/**/*.css\"",
		"lint:styles:fix": "stylelint \"src/**/*.css\" --fix && jst-lint styles",
		"knip": "knip",
		"test": "vitest",
		"test:unit": "vitest run --passWithNoTests",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:lighthouse": "lhci autorun",
		"doctor": "react-doctor . --blocking warning --no-supply-chain --no-telemetry --yes",
		"doctor:staged": "react-doctor --staged --blocking warning --no-supply-chain --no-telemetry --yes",
		"check": "npm run lint && npm run doctor && npm run test:unit && npm run build && npm run lint:budgets && npm run knip",
		"prepare": "husky"
	},
	"dependencies": {
		"@mantine/core": "^9.6.1",
		"@mantine/hooks": "^9.5.2",
		"@needle-di/core": "^1.2.1",
		"@react-router/node": "^8.3.1",
		"@react-router/serve": "^8.3.1",
		"@reatom/core": "^1001.3.0",
		"@reatom/react": "^1001.0.1",
		"clsx": "^2.1.1",
		"isbot": "^5.2.2",
		"lucide-react": "^1.47.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.3.1",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.5.1",
		"@axe-core/playwright": "^4.13.0",
		"@eslint-react/eslint-plugin": "^5.23.3",
		"@jst-stack/eslint-plugin": "^0.3.2",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@react-router/dev": "^8.3.1",
		"@react-router/fs-routes": "^8.3.1",
		"@tailwindcss/cli": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.19.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.11.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"husky": "^9.1.7",
		"jsdom": "^29.0.0",
		"knip": "^6.39.0",
		"lint-staged": "^17.6.0",
		"msw": "^2.12.10",
		"react-doctor": "0.9.14",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vite": "^8.3.1",
		"vite-plugin-svg-icons-ng": "^1.10.0",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"eslint-plugin-regexp": "3.1.1"
	},
	"knip": {
		"ignore": [
			"doctor.config.ts",
			"lighthouserc.cjs"
		]
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --cache --cache-strategy content --fix",
			"vitest related --run"
		],
		"*.{css,scss}": [
			"stylelint --fix",
			"jst-lint styles"
		],
		"*.{json,html}": [
			"eslint --fix"
		]
	}
}
